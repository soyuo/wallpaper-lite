{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "soyuo",
    "shortDescription": "Live wallpaper for Windows",
    "category": "Utility",
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/wallpaper-host"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
